<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="vorevia_about_page" name="About Vorevia Technologies">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure vov-about">
                <section class="vov-about-hero" data-name="About Vorevia">
                    <div class="vov-container vov-about-hero__content">
                        <p class="vov-kicker">ABOUT US</p>
                        <h1>Making connected operations <span>practical.</span></h1>
                        <p class="vov-about-hero__description">Vorevia helps businesses simplify operations, connect teams, and make technology work around their needs. We focus on practical solutions that improve efficiency, support growth, and adapt as businesses evolve.</p>
                        <ul class="vov-about-hero__strengths" aria-label="Our focus">
                            <li><span class="vov-about-hero__strength-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="7"/><circle cx="12" cy="12" r="2"/><path d="m16.95 7.05-3.54 3.54"/></svg></span><span>Business-first approach</span></li>
                            <li><span class="vov-about-hero__strength-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="12" r="2"/><circle cx="18" cy="6" r="2"/><circle cx="18" cy="18" r="2"/><path d="m7.8 11 8.4-4M7.8 13l8.4 4"/></svg></span><span>Connected operations</span></li>
                            <li><span class="vov-about-hero__strength-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 18V6M4 18h16"/><path d="m7 15 4-4 3 2 5-6"/><path d="M16 7h3v3"/></svg></span><span>Built for growth</span></li>
                        </ul>
                        <div class="vov-about-hero__actions">
                            <a class="vov-button vov-button-primary" href="#our-approach">Explore our approach <i class="fa fa-arrow-right" aria-hidden="true"/></a>
                            <a class="vov-button vov-button-secondary" href="/contact">Get in touch</a>
                        </div>
                    </div>
                    <div class="vov-about-hero__media" aria-hidden="true">
                        <img src="/website_vorevia/static/src/img/vorevia-about-hero-glass-workflow.webp" alt=""
                             width="2896" height="2172" fetchpriority="high" decoding="async"/>
                    </div>
                </section>

                <section id="who-we-are" class="vov-about-identity" data-name="Who We Are">
                    <div class="vov-container vov-about-identity__grid">
                        <div class="vov-about-identity__heading"><p class="vov-kicker">WHO WE ARE</p><h2>Business context comes first.</h2></div>
                        <div class="vov-about-identity__copy" data-vov-about-expand="1">
                            <div class="vov-about-identity__description">
                                <h3>Our starting point</h3>
                                <p class="vov-about-identity__lead">Vorevia Technologies is a technology firm based in Kathmandu that aims to make tech solutions more accessible for enterprises to streamline operations, enhance productivity, and establish robust groundwork for sustainable growth. Our ERP implementation, customization, system integration and business process improvement expertise focuses on creating a technological solution that meets actual business requirements.</p>
                                <div id="vov-about-description-more" data-vov-about-more="1">
                                    <h3>Understanding the business</h3>
                                    <p>We feel that each organization has unique processes, responsibilities, challenges and aspirations. That is why our strategy is to first understand the business and then talk about software.</p>
                                    <h3>Mapping the workflow</h3>
                                    <p>We have the time to look at the way teams function, the flow of information among departments, where inefficiencies lie, and what stands in the way of getting the day's work done.</p>
                                    <h3>Connecting daily operations</h3>
                                    <p>Whatever an organization is doing, from selling to buying, stocking, funding, customer relationship, or services delivery, we are here to tie them all together in a connected, reliable, and manageable way.</p>
                                    <h3>One system, fewer gaps</h3>
                                    <p>We help businesses transcend disconnected applications, repetitive manual tasks and fragmented information through an ERP solution that is designed, customized and developed to answer the call of business.</p>
                                    <h3>Designed for adoption</h3>
                                    <p>We are not just about the technology; usability, employee adoption, system reliability, and the evolving needs of a growing organization are all taken into account.</p>
                                    <h3>Making transformation practical</h3>
                                    <p>Successful digital transformation is not just about introducing new tools; it is about making a difference in how people work together, find information, make decisions and serve their customers.</p>
                                    <h3>Built for today and tomorrow</h3>
                                    <p>We at Vorevia Technologies appreciate clarity, collaboration and long-term thinking, and look to provide solutions that are practical for today and adaptable for tomorrow.</p>
                                    <p>We want technology to be a reliable part of the business routine, empowering businesses to be more confident, gain visibility in their processes, and dedicate more time and resources to what really matters.</p>
                                </div>
                            </div>
                            <button type="button" class="vov-about-identity__toggle" data-vov-about-toggle="1" aria-controls="vov-about-description-more" aria-expanded="false" hidden="hidden">
                                <span class="vov-about-identity__toggle-text" data-vov-about-toggle-text="1">See More</span>
                                <span class="vov-about-identity__toggle-arrow" aria-hidden="true">
                                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 19 19 5M8 5h11v11"/></svg>
                                </span>
                            </button>
                            <div class="vov-about-capabilities" aria-label="What we work on"><span>Odoo implementation</span><span>Workflow customization</span><span>Connected operations</span><span>Adoption and support</span></div>
                        </div>
                    </div>
                </section>

                <section class="vov-about-founder" data-name="Founder's Note">
                    <div class="vov-container vov-about-founder__layout">
                        <div class="vov-about-founder__profile">
                            <img src="/website_vorevia/static/src/img/vorevia-founder-mid-torso.png" alt="Founder of Vorevia Technologies Pvt. Ltd." width="1312" height="1199" loading="lazy" decoding="async"/>
                            <p><strong>Founder</strong><span>Vorevia Technologies Pvt. Ltd.</span></p>
                        </div>
                        <div class="vov-about-founder__message">
                            <span class="vov-about-founder__quote-icon" aria-hidden="true">“</span>
                            <h2>Founder's Note</h2>
                            <blockquote>“Technology should adapt to the way a business works, not the other way around. At Vorevia Technologies Pvt. Ltd., our purpose is to simplify everyday challenges, connect people and processes, and build solutions that businesses can rely on as they grow.”</blockquote>
                        </div>
                    </div>
                </section>

                <section id="our-approach" class="vov-about-approach" data-name="Our Approach">
                    <div class="vov-container">
                        <div class="vov-about-approach__lead"><div><p class="vov-kicker">OUR APPROACH</p><h2>From understanding to everyday use.</h2></div></div>
                        <ol class="vov-about-journey" aria-label="Vorevia's five-stage engagement process">
                            <li><span>01</span><h3>Understand</h3><p>Clarify the business requirements, goals, and day-to-day context.</p></li>
                            <li><span>02</span><h3>Plan</h3><p>Define the solution, priorities, scope, and practical next steps.</p></li>
                            <li><span>03</span><h3>Implement</h3><p>Configure the system and connect the necessary workflows and integrations.</p></li>
                            <li><span>04</span><h3>Enable</h3><p>Test together and prepare the people who will use the new way of working.</p></li>
                            <li><span>05</span><h3>Support and Grow</h3><p>Improve the system over time as the business, teams, and priorities evolve.</p></li>
                        </ol>
                    </div>
                </section>

                <section id="our-principles" class="vov-about-principles" data-name="Our Principles">
                    <div class="vov-container">
                        <p class="vov-kicker">HOW WE THINK</p>
                        <h2>Useful systems are built with care.</h2>
                        <div class="vov-about-principles__grid">
                            <article><h3>Practical fit</h3><p>Choose the workflow that supports the business, with customization only where it adds value.</p></article>
                            <article><h3>Clear communication</h3><p>Make decisions and tradeoffs understandable to the people who will use the system.</p></article>
                            <article><h3>Room to change</h3><p>Build a foundation that can be refined as responsibilities and priorities evolve.</p></article>
                        </div>
                    </div>
                </section>

                <section class="vov-about-cta" data-name="Start a Conversation">
                    <div class="vov-container vov-about-cta__inner">
                        <div><p class="vov-kicker">LET'S WORK TOGETHER</p><h2>Start with the process you want to improve.</h2><p>Tell us where work slows down or information gets lost. We can help identify a practical starting point.</p></div>
                        <a class="vov-button vov-button-primary" href="/contact">Discuss your workflow <i class="fa fa-arrow-right" aria-hidden="true"/></a>
                    </div>
                </section>
            </div>
        </t>
    </template>
    <record id="vorevia_about_page_record" model="website.page">
        <field name="name">About Vorevia Technologies</field>
        <field name="url">/about</field>
        <field name="view_id" ref="vorevia_about_page"/>
        <field name="is_published">True</field>
    </record>
</odoo>
