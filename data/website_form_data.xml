<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="model_vorevia_consultation" model="ir.model">
        <field name="website_form_key">vorevia_consultation</field>
        <field name="website_form_default_field_id" ref="field_vorevia_consultation__description"/>
        <field name="website_form_access">True</field>
        <field name="website_form_label">Request a Consultation</field>
    </record>
    <function model="ir.model.fields" name="formbuilder_whitelist">
        <value>vorevia.consultation</value>
        <value eval="['name', 'email', 'company', 'phone', 'interest', 'description']"/>
    </function>
</odoo>
