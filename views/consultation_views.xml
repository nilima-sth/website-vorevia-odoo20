<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vorevia_consultation_view_list" model="ir.ui.view">
        <field name="name">vorevia.consultation.list</field>
        <field name="model">vorevia.consultation</field>
        <field name="arch" type="xml">
            <list string="Consultation Requests" default_order="create_date desc">
                <field name="create_date"/>
                <field name="name"/>
                <field name="company"/>
                <field name="email"/>
                <field name="partner_id"/>
                <field name="interest"/>
                <field name="timeline" optional="show"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="vorevia_consultation_view_form" model="ir.ui.view">
        <field name="name">vorevia.consultation.form</field>
        <field name="model">vorevia.consultation</field>
        <field name="arch" type="xml">
            <form string="Consultation Request">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company"/>
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="interest"/>
                            <field name="timeline"/>
                            <field name="referral_source"/>
                            <field name="state"/>
                            <field name="create_date" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="vorevia_consultation_action" model="ir.actions.act_window">
        <field name="name">Consultation Requests</field>
        <field name="res_model">vorevia.consultation</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="vorevia_consultation_menu"
              name="Consultation Requests"
              parent="website.menu_website_configuration"
              action="vorevia_consultation_action"
              sequence="35"/>
</odoo>
