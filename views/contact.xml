<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="vorevia_contact_page" name="Contact Vorevia Technologies">
        <t t-call="website.layout">
            <t t-set="additional_title">Contact Us</t>
            <div id="wrap" class="oe_structure vov-contact-page">
                <section class="vov-contact-page__body" data-name="Contact Details and Enquiry Form">
                    <div class="vov-container vov-contact-page__grid">
                        <aside class="vov-contact-info" aria-label="Vorevia contact details">
                            <header class="vov-contact-introduction">
                                <p class="vov-kicker">CONTACT VOREVIA</p>
                                <h1>Let’s talk about what <span>you want to improve.</span></h1>
                                <p>Tell us what you need. We'll help you find the right solution.</p>
                            </header>
                            <address class="vov-contact-details">
                                <div class="vov-contact-details__item">
                                    <div class="vov-contact-details__icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                            <rect x="3" y="5" width="18" height="14" rx="2"/>
                                            <path d="m4 7 8 6 8-6"/>
                                        </svg>
                                    </div>
                                    <div class="vov-contact-details__content">
                                        <span>Email</span>
                                        <a href="mailto:info@vorevia.com">info@vorevia.com</a>
                                    </div>
                                </div>
                                <div class="vov-contact-details__item">
                                    <div class="vov-contact-details__icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.86 19.86 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.86 19.86 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.9.33 1.78.63 2.62a2 2 0 0 1-.45 2.11L8 9.91a16 16 0 0 0 6.09 6.09l1.46-1.29a2 2 0 0 1 2.11-.45c.84.3 1.72.51 2.62.63A2 2 0 0 1 22 16.92Z"/>
                                        </svg>
                                    </div>
                                    <div class="vov-contact-details__content">
                                        <span>Phone</span>
                                        <a href="tel:+9779712030420">+977 971-2030420</a>
                                    </div>
                                </div>
                                <div class="vov-contact-details__item">
                                    <div class="vov-contact-details__icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M12 21s-6-4.35-6-10a6 6 0 1 1 12 0c0 5.65-6 10-6 10Z"/>
                                            <circle cx="12" cy="11" r="2.5"/>
                                        </svg>
                                    </div>
                                    <div class="vov-contact-details__content">
                                        <span>Office location</span>
                                        <a href="https://www.google.com/maps/search/?api=1&amp;query=Kathmandu%2C%20Nepal" target="_blank" rel="noopener noreferrer">Kathmandu, Nepal</a>
                                    </div>
                                </div>
                            </address>
                            <div class="vov-contact-map">
                                <iframe src="https://www.google.com/maps/embed?pb=!1m17!1m12!1m3!1d4816.748898441512!2d85.31559547546641!3d27.680131476198124!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m2!1m1!2zMjfCsDQwJzQ4LjUiTiA4NcKwMTknMDUuNCJF!5e1!3m2!1sen!2snp!4v1794071230445!5m2!1sen!2snp"
                                        title="Vorevia Technologies office location"
                                        width="600" height="450" style="border:0;"
                                        allowfullscreen="" loading="lazy"
                                        referrerpolicy="strict-origin-when-cross-origin"/>
                            </div>
                        </aside>

                        <section class="vov-contact-enquiry s_website_form" data-vcss="001" data-snippet="s_website_form" aria-labelledby="vov-contact-form-title">
                            <div class="vov-contact-enquiry__heading">
                                <p class="vov-kicker">SEND AN ENQUIRY</p>
                                <h2 id="vov-contact-form-title">Tell us what you’re planning.</h2>
                                <p>A few practical details will help us understand the requirement and suggest a sensible next step.</p>
                            </div>
                            <form action="/website/form/" method="post" enctype="multipart/form-data"
                                  class="o_mark_required vov-contact-form"
                                  data-mark="*" data-pre-fill="true"
                                  data-model_name="vorevia.consultation"
                                  data-success-mode="redirect"
                                  data-success-page="/contactus-thank-you">
                                <div class="vov-contact-form__grid s_website_form_rows">
                                    <div class="vov-contact-form__field vov-contact-form__field--wide s_website_form_field s_website_form_custom s_website_form_required" data-type="char">
                                        <label for="vov_contact_name">Full name *</label>
                                        <input id="vov_contact_name" class="form-control s_website_form_input" type="text" name="name" required="required" autocomplete="name" data-fill-with="name" placeholder="Your full name"/>
                                    </div>
                                    <div class="vov-contact-form__field vov-contact-form__field--wide s_website_form_field s_website_form_model_required" data-type="email">
                                        <label for="vov_contact_email">Work email *</label>
                                        <input id="vov_contact_email" class="form-control s_website_form_input" type="email" name="email" required="required" autocomplete="email" data-fill-with="email" placeholder="you@company.com"/>
                                    </div>
                                    <div class="vov-contact-form__field s_website_form_field s_website_form_custom" data-type="char">
                                        <label for="vov_contact_company">Company</label>
                                        <input id="vov_contact_company" class="form-control s_website_form_input" type="text" name="company" autocomplete="organization" placeholder="Company name"/>
                                    </div>
                                    <div class="vov-contact-form__field s_website_form_field s_website_form_custom" data-type="char">
                                        <label for="vov_contact_phone">Phone</label>
                                        <input id="vov_contact_phone" class="form-control s_website_form_input" type="tel" name="phone" autocomplete="tel" placeholder="+977…"/>
                                    </div>
                                    <div class="vov-contact-form__field vov-contact-form__field--wide s_website_form_field s_website_form_model_required" data-type="selection">
                                        <label for="vov_contact_interest">How can we help? *</label>
                                        <select id="vov_contact_interest" class="form-select s_website_form_input" name="interest" required="required">
                                            <option value="" selected="selected" disabled="disabled">Select a service</option>
                                            <option value="implementation">ERP implementation</option>
                                            <option value="customization">Custom development</option>
                                            <option value="integration">Integration or migration</option>
                                            <option value="support">Training or support</option>
                                            <option value="unsure">Not sure yet</option>
                                        </select>
                                    </div>
                                    <div class="vov-contact-form__field vov-contact-form__field--wide s_website_form_field s_website_form_custom s_website_form_required" data-type="text">
                                        <label for="vov_contact_description">Project details *</label>
                                        <textarea id="vov_contact_description" class="form-control s_website_form_input" name="description" rows="6" required="required" placeholder="Tell us what is happening today and what you would like to improve."/>
                                    </div>
                                    <div class="vov-contact-form__field s_website_form_field s_website_form_custom" data-type="selection">
                                        <label for="vov_contact_timeline">Timeline <span>(optional)</span></label>
                                        <select id="vov_contact_timeline" class="form-select s_website_form_input" name="timeline">
                                            <option value="" selected="selected">Select timeline</option>
                                            <option value="asap">As soon as possible</option>
                                            <option value="one_month">Within 1 month</option>
                                            <option value="one_three_months">Within 1–3 months</option>
                                            <option value="three_six_months">Within 3–6 months</option>
                                            <option value="exploring">Just exploring</option>
                                            <option value="unsure">Not sure yet</option>
                                        </select>
                                    </div>
                                    <div class="vov-contact-form__field s_website_form_field s_website_form_custom" data-type="selection">
                                        <label for="vov_contact_source">How did you hear about us? <span>(optional)</span></label>
                                        <select id="vov_contact_source" class="form-select s_website_form_input" name="referral_source">
                                            <option value="" selected="selected">Select source</option>
                                            <option value="google">Google Search</option>
                                            <option value="linkedin">LinkedIn</option>
                                            <option value="social">Facebook / Instagram</option>
                                            <option value="referral">Friend or colleague</option>
                                            <option value="client">Existing client</option>
                                            <option value="other">Other</option>
                                        </select>
                                    </div>
                                    <div class="vov-contact-form__submit vov-contact-form__field--wide s_website_form_submit">
                                        <span id="s_website_form_result"/>
                                        <a href="#" role="button" class="vov-button vov-button-primary s_website_form_send">Send Enquiry <span aria-hidden="true">→</span></a>
                                    </div>
                                </div>
                            </form>
                        </section>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <record id="vorevia_contact_page_record" model="website.page">
        <field name="name">Contact Vorevia Technologies</field>
        <field name="url">/contact</field>
        <field name="view_id" ref="vorevia_contact_page"/>
        <field name="is_published">True</field>
    </record>
</odoo>
